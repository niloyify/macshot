{
  "name": "jhuli",
  "productName": "Jhuli",
  "version": "3.1.0",
  "description": "Jhuli (ঝুলি — TouchKit and MacShot in one app): 120+ everyday tools plus screenshots, screen and sound recording, OCR, annotate and colour picker in one simple app for Windows, macOS, Linux, phones and the web, with one account synced everywhere.",
  "main": "src/main.js",
  "author": {
    "name": "niloyify",
    "email": "niloyify@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.niloyify.jhuli",
    "productName": "Jhuli",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "web/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Jhuli records your voice with screen recordings, sound recordings and videos.",
        "NSCameraUsageDescription": "Jhuli takes photos with your camera.",
        "NSScreenCaptureUsageDescription": "Jhuli takes screenshots and records the screen.",
        "NSLocalNetworkUsageDescription": "Jhuli lets your phone control this computer over Wi-Fi."
      },
      "extraResources": [
        {
          "from": "native/mac/input",
          "to": "native/mac/input"
        }
      ],
      "x64ArchFiles": "Contents/Resources/native/mac/input"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "native/win/input.ps1",
          "to": "native/win/input.ps1"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Jhuli-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Jhuli-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "niloyify <niloyify@users.noreply.github.com>"
    }
  },
  "homepage": "https://github.com/niloyify/macshot/tree/main/touchkit",
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  }
}
