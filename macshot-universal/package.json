{
  "name": "macshot",
  "productName": "MacShot",
  "version": "2.1.0",
  "description": "MacShot: screenshots, screen and sound recording, OCR, annotate, colour picker, clipboard history, notes, timer, QR codes and an image converter for Windows, macOS and Linux",
  "main": "src/main.js",
  "author": {
    "name": "niloyify",
    "email": "niloyify@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.niloyify.macshot",
    "productName": "MacShot",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "MacShot records your voice and the sound around you.",
        "NSScreenCaptureUsageDescription": "MacShot takes screenshots and records the screen."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "MacShot-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MacShot-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "niloyify <niloyify@users.noreply.github.com>"
    }
  },
  "homepage": "https://github.com/niloyify/macshot/tree/main/macshot-universal"
}
